# Configuration precedence: CLI > process environment > .env > safe default.

# Backend
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=MeetingMinutesAI;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
AudioStorage__RootPath=
AudioStorage__MaxBytes=524288000
AIService__BaseUrl=http://127.0.0.1:8000
AIService__TimeoutSeconds=7200
AIService__MaxResponseBytes=67108864
Jwt__SecretKey=
Jwt__Issuer=MeetingMinutesAI.Api
Jwt__Audience=MeetingMinutesAI.Client
Jwt__ExpiryMinutes=1440

# Frontend build/runtime
VITE_API_BASE_URL=http://localhost:5080

# AI service
MM_AI_STT_MODEL=large-v3-turbo
MM_AI_DEVICE=cuda
MM_AI_COMPUTE_TYPE=float16
GEMINI_API_KEY=
MM_AI_DEFAULT_MODE=fast
MM_AI_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
MM_AI_GEMINI_QUALITY_MODEL=gemini-3.6-flash
MM_AI_MAX_AUDIO_BYTES=524288000
MM_AI_MAX_AUDIO_DURATION_SECONDS=5400
MM_AI_GEMINI_INLINE_LIMIT_BYTES=20971520
MM_AI_LOCAL_FAST_STT_MODEL=small
MM_AI_LOCAL_QUALITY_STT_MODEL=large-v3-turbo
MM_AI_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
MM_AI_LOCAL_FAST_MINUTES_MODEL=qwen2.5:3b-instruct
MM_AI_LOCAL_QUALITY_MINUTES_MODEL=qwen2.5:3b-instruct
MM_AI_LOCAL_LLM_API_KEY=
MM_AI_LOCAL_LLM_TIMEOUT_SECONDS=300

# Leave secrets empty. Put real values only in ignored .env files.
HF_TOKEN=
