{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-minutes-ai.local/schemas/dataset-manifest-v1.json",
  "title": "Meeting Minutes AI private dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "status",
    "privacy",
    "recordings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "locked"]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsPrivateData",
        "mediaCommitted",
        "transcriptsCommitted"
      ],
      "properties": {
        "containsPrivateData": {
          "type": "boolean"
        },
        "mediaCommitted": {
          "const": false
        },
        "transcriptsCommitted": {
          "const": false
        }
      }
    },
    "recordings": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/recording"
      }
    }
  },
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordingId",
        "sourceType",
        "speechStyle",
        "sha256",
        "audio",
        "speakers",
        "capture",
        "rights",
        "annotations",
        "split",
        "locked"
      ],
      "properties": {
        "recordingId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "sourceType": {
          "enum": ["recorded", "generated"]
        },
        "speechStyle": {
          "enum": ["read", "monologue", "conversational"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "durationSeconds",
            "sampleRateHz",
            "channels"
          ],
          "properties": {
            "format": {
              "enum": ["wav", "flac", "mp3", "m4a"]
            },
            "durationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sampleRateHz": {
              "type": "integer",
              "minimum": 8000
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "speakers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "languages", "accents", "overlap"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "languages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "accents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "overlap": {
              "enum": ["none", "light", "material"]
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["microphone", "noise"],
          "properties": {
            "microphone": {
              "type": "string",
              "minLength": 1
            },
            "noise": {
              "enum": ["clean", "light", "moderate", "heavy"]
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consentDocumented",
            "consentRecord",
            "usageRights",
            "publicationStatus"
          ],
          "properties": {
            "consentDocumented": {
              "type": "boolean"
            },
            "consentRecord": {
              "enum": ["local-record", "not-required-generated"]
            },
            "usageRights": {
              "enum": [
                "evaluation-only",
                "private-project",
                "redistributable-generated"
              ]
            },
            "publicationStatus": {
              "enum": [
                "private",
                "anonymized-metadata-only",
                "redistributable"
              ]
            }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceVerified",
            "timestampsVerified",
            "speakersVerified"
          ],
          "properties": {
            "referenceVerified": {
              "type": "boolean"
            },
            "timestampsVerified": {
              "type": "boolean"
            },
            "speakersVerified": {
              "type": "boolean"
            }
          }
        },
        "split": {
          "enum": ["development", "final-test"]
        },
        "locked": {
          "type": "boolean"
        }
      }
    }
  }
}
